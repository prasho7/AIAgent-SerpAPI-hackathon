# Google AI Studio API Key (Get it from aistudio.google.com)
GEMINI_API_KEY=your_gemini_api_key_here

# SerpApi API Key (Get it from serpapi.com)
SERPAPI_API_KEY=your_serpapi_api_key_here

# Model choice: gemini-3.5-flash (fast/recommended) or gemini-3.5-flash-lite
GEMINI_MODEL=gemini-3.5-flash

# Environment: development or production
APP_ENV=development

# Shopping Market Configuration (Defaults to India / English)
SHOPPING_GL=in
SHOPPING_HL=en
SHOPPING_MARKET_LABEL=India